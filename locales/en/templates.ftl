user-info =
    🧑‍💻 *{ $name }* \<`{ $id }`\>
    🗺 *Common chats*: *{ $chats }*

    👮‍♂️ *Status*: { $status }
    🏳️‍🌈 *Pidor of day*: { $pidor_local } of { $pidor_all }

user-stats =
    📊 *Stats*

    🧑‍💻 *Users*: { $chat_users } of { $users } users
    💻 *Commands*: { $chat_commands } of { $commands } commands

dev-status =
  🤖 *{ $name }* `v{ $version }`
  🕓 *uptime*: { $uptime }

wget =
  { $code_emoji } *{ $url }*

  🔘 *Code*: { $code }
  📦 *Size*: { $size }
  🕓 *Time*: { $time }
